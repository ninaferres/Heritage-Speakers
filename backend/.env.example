# Server
PORT=8787
CORS_ORIGIN=http://localhost:5173

# Supabase (used to verify user session tokens sent from the frontend)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Service role key is optional; only needed if you add server-side DB writes later.
SUPABASE_SERVICE_ROLE_KEY=

# AI grading — Groq is used by default (free), Anthropic/OpenAI are optional alt providers
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Speech-to-text (Whisper) — uses GROQ_API_KEY above for free; OPENAI_API_KEY is a paid fallback

# Text-to-speech, Peninsular Spanish + Russian (Listening exercises)
# Google Cloud Text-to-Speech free tier: 1M WaveNet/Neural2 characters/month, doesn't expire.
GOOGLE_TTS_API_KEY=
# Voice names default to sensible built-in values; override only if you want different ones.
GOOGLE_TTS_VOICE_ES=
GOOGLE_TTS_VOICE_RU=

# Welcome emails on sign-up (optional) — resend.com free tier
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Feedback mailbox admin key (optional) — set any secret to enable GET /api/feedback
FEEDBACK_ADMIN_KEY=
