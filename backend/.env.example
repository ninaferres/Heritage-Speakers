# Server
PORT=8787
CORS_ORIGIN=http://localhost:5173

# Supabase (used to verify user session tokens sent from the frontend)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Service role key is optional; only needed if you add server-side DB writes later.
SUPABASE_SERVICE_ROLE_KEY=

# AI grading — Groq is used by default (free), Anthropic/OpenAI are optional alt providers
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Speech-to-text (Whisper) — uses GROQ_API_KEY above for free; OPENAI_API_KEY is a paid fallback

# Text-to-speech, multi-accent Spanish + Russian (Listening exercises)
# Azure Speech free tier: 500,000 characters/month, doesn't expire.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus
# Voice names default to real per-country neural voices; override only if you want different ones.
AZURE_VOICE_ES=
AZURE_VOICE_MX=
AZURE_VOICE_AR=
AZURE_VOICE_CO=
AZURE_VOICE_RU=
AZURE_VOICE_RU_MOSCOW=

# Welcome emails on sign-up (optional) — resend.com free tier
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Feedback mailbox admin key (optional) — set any secret to enable GET /api/feedback
FEEDBACK_ADMIN_KEY=
