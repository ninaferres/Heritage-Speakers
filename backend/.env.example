# Server
PORT=8787
CORS_ORIGIN=http://localhost:5173

# Supabase (used to verify user session tokens sent from the frontend)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Service role key is optional; only needed if you add server-side DB writes later.
SUPABASE_SERVICE_ROLE_KEY=

# AI grading — Anthropic is used by default, OpenAI as an optional fallback/alt provider
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AI_PROVIDER=anthropic
ANTHROPIC_MODEL=claude-sonnet-4-5
OPENAI_MODEL=gpt-4o

# Speech-to-text (Whisper via OpenAI API) — required for Speaking exercise grading
# Reuses OPENAI_API_KEY above.

# Text-to-speech, multi-accent Spanish (Listening exercises)
ELEVENLABS_API_KEY=
# Voice IDs for each regional accent (create/select voices in your ElevenLabs account)
ELEVENLABS_VOICE_ES=
ELEVENLABS_VOICE_MX=
ELEVENLABS_VOICE_AR=
ELEVENLABS_VOICE_CO=
